{
  "manifest_version": 3,
  "name": "简历自动填 Resume Autofill（本地·开源）",
  "short_name": "简历自动填",
  "version": "0.4.0",
  "description": "一键或自动填写网申表单、上传简历。所有资料只保存在你自己的浏览器里，扩展不发送任何网络请求。",
  "permissions": [
    "storage",
    "unlimitedStorage",
    "activeTab",
    "scripting",
    "sidePanel"
  ],
  "optional_host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "src/background.js"
  },
  "action": {
    "default_title": "简历自动填",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png"
    }
  },
  "options_ui": {
    "page": "src/app.html",
    "open_in_tab": true
  },
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Alt+Shift+F"
      },
      "description": "打开简历自动填侧边栏"
    }
  },
  "content_security_policy": {
    "extension_pages": "default-src 'none'; script-src 'self'; style-src 'self'; img-src 'self' data: blob:; frame-src blob:; object-src 'self'; connect-src 'self'; form-action 'none'; base-uri 'none'"
  },
  "side_panel": {
    "default_path": "src/panel.html"
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "minimum_chrome_version": "116"
}
